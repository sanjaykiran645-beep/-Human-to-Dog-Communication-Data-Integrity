# ==============================================================================
# CANINESENSE AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the FastAPI server.
# NEVER commit the real .env file or production credentials to version control.
# ==============================================================================

# Application & Security Settings
# Generate a cryptographically secure 64-char key: python -c "import secrets; print(secrets.token_hex(32))"
CANINESENSE_SECRET_KEY=replace-with-a-long-random-string
CANINESENSE_ENV=development
CANINESENSE_ACCESS_TOKEN_MINUTES=1440

# Data & Persistence Directory
CANINESENSE_DATA_DIR=./data

# CORS Allowed Origins (comma-separated URLs)
CANINESENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,https://sanjaykiran645-beep.github.io

# Security: Allowed frame ancestors for iframes (optional)
CANINESENSE_FRAME_ANCESTORS=

# Audio Decoding & Processing Tools
# If FFmpeg is installed in a custom non-PATH directory, provide the full binary path:
# Windows Example: C:\ffmpeg\bin\ffmpeg.exe
# Linux Example: /usr/bin/ffmpeg
FFMPEG_PATH=

# Rate Limiting & Capacity (Optional overrides)
# CANINESENSE_RATE_LIMIT_GENERAL=240
# CANINESENSE_RATE_LIMIT_AUTH=40
# CANINESENSE_RATE_LIMIT_ANALYZE=40
# CANINESENSE_RATE_LIMIT_GENERATE=50
