# ==============================================================================
# CANINESENSE AI — FRONTEND VITE ENVIRONMENT CONFIGURATION
# Copy to frontend/.env.local for local overrides.
# ==============================================================================

# Backend API URL (leave empty for same-origin or local proxy /api during development)
VITE_API_URL=http://localhost:8000

# Production Cloud Backend URL (used when deployed on GitHub Pages or custom host)
VITE_PRODUCTION_BACKEND_URL=https://caninesense-backend.onrender.com

# Target for Vite local dev server proxy (defaults to http://127.0.0.1:8000)
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Environment Name
VITE_APP_ENV=development
